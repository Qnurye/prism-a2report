---
import { getCollection } from "astro:content";
import ReportLayout from "../../layouts/ReportLayout.astro";
import SectionRenderer from "../../components/SectionRenderer.astro";
import { extractHeadings } from "../../lib/extract-headings";

export async function getStaticPaths() {
  const reports = await getCollection("reports");
  return reports.map((report) => ({
    params: { slug: report.id },
    props: { report },
  }));
}

const { report } = Astro.props;
const headings = extractHeadings(report.data.sections);
---

<ReportLayout title={report.data.title} lang={report.data.lang} tocHeadings={headings}>
  <SectionRenderer sections={report.data.sections} />
</ReportLayout>
