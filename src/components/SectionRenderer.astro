---
import { marked } from "marked";
import { slugify } from "../lib/slugify";
import Chart from "./Chart.astro";
import Table from "./Table.astro";
import Callout from "./Callout.astro";
import CodeBlock from "./CodeBlock.astro";
import StatCard from "./StatCard.astro";
import Tabs from "./Tabs.astro";
import Timeline from "./Timeline.astro";
import Figure from "./Figure.astro";
import Quote from "./Quote.astro";
import Accordion from "./Accordion.astro";
import Comparison from "./Comparison.astro";
import Progress from "./Progress.astro";
import MetricsGrid from "./MetricsGrid.astro";
import Steps from "./Steps.astro";
import Diff from "./Diff.astro";
import Embed from "./Embed.astro";
import Gallery from "./Gallery.astro";
import SourceList from "./SourceList.astro";

interface Section {
  type: string;
  [key: string]: any;
}

interface Props {
  sections: Section[];
}

const { sections } = Astro.props;
---

{
  sections.map((section) => (
    <>
      {section.type === "text" && (
        <div class="prose">
          {section.heading && (
            <Fragment
              set:html={`<h${section.level || 2} id="${slugify(section.heading)}">${section.heading}</h${section.level || 2}>`}
            />
          )}
          <Fragment set:html={marked.parse(section.content, { breaks: true })} />
        </div>
      )}
      {section.type === "chart" && (
        <Chart chartType={section.chartType} data={section.data} options={section.options} />
      )}
      {section.type === "table" && (
        <Table headers={section.headers} rows={section.rows} caption={section.caption} />
      )}
      {section.type === "code" && (
        <CodeBlock language={section.language} filename={section.filename} code={section.code} />
      )}
      {section.type === "callout" && (
        <Callout variant={section.variant} title={section.title}>
          <Fragment set:html={marked.parse(section.content, { breaks: true })} />
        </Callout>
      )}
      {section.type === "statcard" && (
        <StatCard
          label={section.label}
          value={section.value}
          description={section.description}
          trend={section.trend}
          trendValue={section.trendValue}
        />
      )}
      {section.type === "tabs" && <Tabs tabs={section.tabs} defaultTab={section.defaultTab} />}
      {section.type === "timeline" && <Timeline events={section.events} />}
      {section.type === "figure" && (
        <Figure
          src={section.src}
          alt={section.alt}
          caption={section.caption}
          width={section.width}
        />
      )}
      {section.type === "quote" && (
        <Quote text={section.text} author={section.author} role={section.role} />
      )}
      {section.type === "accordion" && (
        <Accordion items={section.items} allowMultiple={section.allowMultiple} />
      )}
      {section.type === "comparison" && (
        <Comparison items={section.items} title={section.title} layout={section.layout} />
      )}
      {section.type === "progress" && (
        <Progress
          mode={section.mode}
          label={section.label}
          value={section.value}
          max={section.max}
          showPercent={section.showPercent}
          variant={section.variant}
          items={section.items}
        />
      )}
      {section.type === "metrics-grid" && (
        <MetricsGrid metrics={section.metrics} columns={section.columns} />
      )}
      {section.type === "steps" && (
        <Steps
          steps={section.steps}
          orientation={section.orientation}
          currentStep={section.currentStep}
        />
      )}
      {section.type === "diff" && (
        <Diff
          before={section.before}
          after={section.after}
          language={section.language}
          title={section.title}
        />
      )}
      {section.type === "embed" && (
        <Embed
          src={section.src}
          title={section.title}
          aspectRatio={section.aspectRatio}
          allowFullscreen={section.allowFullscreen}
        />
      )}
      {section.type === "gallery" && <Gallery images={section.images} columns={section.columns} />}
      {section.type === "source-list" && (
        <SourceList sources={section.sources} title={section.title} />
      )}
    </>
  ))
}
