---
import "../styles/global.css";
// CJK fonts: vite-plugin-font slices these at build time
import "../../fonts/LXGWNeoXiHei.ttf";
import "../../fonts/GenRyuMin2TC-R.otf";

interface Props {
  title: string;
  lang?: string;
  tocHeadings?: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
}

const { title, lang = "en", tocHeadings = [] } = Astro.props;
const tocEntries = tocHeadings.filter((heading) => heading.depth >= 2 && heading.depth <= 4);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:image" content="https://prism.qnury.es/og.png" />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />

    <!-- Dark mode: prevent FOUC -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        if (stored === "dark" || (!stored && matchMedia("(prefers-color-scheme: dark)").matches)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>

    <!-- Google Fonts: Inter, IBM Plex Sans, Baskervville -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Baskervville:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <!-- Maple Mono CN (pre-sliced CJK monospace from CDN) -->
    <link rel="preconnect" href="https://chinese-fonts-cdn.deno.dev" crossorigin />
    <link
      rel="stylesheet"
      href="https://chinese-fonts-cdn.deno.dev/packages/maple-mono-cn/dist/MapleMono-CN-Regular/result.css"
    />
  </head>
  <body>
    {
      tocEntries.length > 0 && (
        <>
          <aside class="a2r-toc a2r-toc-desktop" aria-label="Table of contents">
            <p class="a2r-toc-title">On this page</p>
            <nav>
              <ol class="a2r-toc-list">
                {tocEntries.map((heading) => (
                  <li class={`a2r-toc-item a2r-toc-depth-${heading.depth}`}>
                    <a
                      href={`#${heading.slug}`}
                      class="a2r-toc-link"
                      data-toc-link
                      data-toc-target={heading.slug}
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>

          <div class="a2r-toc-mobile">
            <button
              type="button"
              class="a2r-toc-mobile-toggle"
              id="toc-mobile-toggle"
              aria-haspopup="true"
              aria-controls="toc-mobile-panel"
              aria-expanded="false"
            >
              <span class="sr-only">Toggle table of contents</span>
              <svg viewBox="0 0 24 24" aria-hidden="true" class="a2r-toc-mobile-icon">
                <path
                  d="M4 6h16M4 12h16M4 18h10"
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                />
              </svg>
            </button>
            <div class="a2r-toc-mobile-panel" id="toc-mobile-panel" hidden>
              <p class="a2r-toc-title">On this page</p>
              <nav aria-label="Mobile table of contents">
                <ol class="a2r-toc-list">
                  {tocEntries.map((heading) => (
                    <li class={`a2r-toc-item a2r-toc-depth-${heading.depth}`}>
                      <a
                        href={`#${heading.slug}`}
                        class="a2r-toc-link"
                        data-toc-link
                        data-toc-mobile-link
                        data-toc-target={heading.slug}
                      >
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            </div>
          </div>
        </>
      )
    }
    <div
      class="report-container max-w-4xl mx-auto px-4 sm:px-6 md:px-12 lg:px-24 min-h-screen py-8 sm:py-12"
    >
      <header class="mb-8 flex items-center justify-between">
        <h1 class="font-serif text-3xl sm:text-4xl font-black text-foreground">{title}</h1>
        <button
          id="theme-toggle"
          type="button"
          aria-label="Toggle dark mode"
          class="p-2 rounded-lg bg-secondary text-secondary-foreground hover:bg-accent transition-colors min-w-11 min-h-11 flex items-center justify-center"
        >
          <svg
            id="icon-sun"
            class="hidden w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
            ></path>
          </svg>
          <svg
            id="icon-moon"
            class="hidden w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
            ></path>
          </svg>
        </button>
      </header>
      <main class="prose">
        <slot />
      </main>
    </div>

    <script>
      function updateIcons() {
        const isDark = document.documentElement.classList.contains("dark");
        document.getElementById("icon-sun")!.classList.toggle("hidden", !isDark);
        document.getElementById("icon-moon")!.classList.toggle("hidden", isDark);
      }

      updateIcons();

      document.getElementById("theme-toggle")!.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
        updateIcons();
      });

      const tocLinks = Array.from(document.querySelectorAll<HTMLElement>("[data-toc-link]"));
      if (tocLinks.length > 0) {
        const pageHeadings = Array.from(
          document.querySelectorAll<HTMLElement>(".prose h2[id], .prose h3[id], .prose h4[id]"),
        );

        const setActiveLink = (id: string) => {
          tocLinks.forEach((link) => {
            const isActive = link.dataset.tocTarget === id;
            link.dataset.active = String(isActive);
            link.setAttribute("aria-current", isActive ? "location" : "false");
          });
        };

        const updateActiveSection = () => {
          if (pageHeadings.length === 0) return;
          const pivot = window.innerHeight * 0.35;
          let activeId = pageHeadings[0]?.id ?? "";
          for (const heading of pageHeadings) {
            const top = heading.getBoundingClientRect().top;
            if (top <= pivot) {
              activeId = heading.id;
            } else {
              break;
            }
          }
          if (activeId) setActiveLink(activeId);
        };

        let ticking = false;
        const handleScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            updateActiveSection();
            const maxFadeDistance = 520;
            const fadeProgress = Math.min(window.scrollY / maxFadeDistance, 1);
            document.documentElement.style.setProperty(
              "--a2r-toc-scroll-dim",
              fadeProgress.toFixed(3),
            );
            ticking = false;
          });
        };

        handleScroll();
        window.addEventListener("scroll", handleScroll, { passive: true });
        window.addEventListener("resize", handleScroll);

        const mobileToggle = document.getElementById("toc-mobile-toggle");
        const mobilePanel = document.getElementById("toc-mobile-panel");
        if (mobileToggle && mobilePanel) {
          mobileToggle.addEventListener("click", () => {
            const expanded = mobileToggle.getAttribute("aria-expanded") === "true";
            mobileToggle.setAttribute("aria-expanded", String(!expanded));
            mobilePanel.toggleAttribute("hidden", expanded);
          });
          const mobileLinks = document.querySelectorAll("[data-toc-mobile-link]");
          mobileLinks.forEach((link) => {
            link.addEventListener("click", () => {
              mobileToggle.setAttribute("aria-expanded", "false");
              mobilePanel.setAttribute("hidden", "");
            });
          });
        }
      }
    </script>
  </body>
</html>
